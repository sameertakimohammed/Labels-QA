{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{config.json,public/**,integrations/**}",
      "maxDuration": 60
    },
    "api/[...path].js": {
      "includeFiles": "{config.json,public/**,integrations/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/metrics",
      "destination": "/api/index?__p=/metrics"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__p=/uploads/$1"
    },
    {
      "source": "/((?!api/|metrics$|uploads/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/api/index?__p=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    }
  ]
}
